# Kopier til .env og fyll inn. .env leses automatisk når appen kjører med
# local-profilen (mvn spring-boot:run, eller SPRING_PROFILES_ACTIVE=local i IntelliJ),
# og er lagt i .gitignore. Miljøvariabler satt i IntelliJ eller shellet vinner over .env.
#
# I produksjon (Fly.io) brukes ikke .env; der settes verdiene med `fly secrets set`.

# AI-leverandør: fake | anthropic | gemini (lokalt er fake standard)
AI_PROVIDER=anthropic

# Valgfritt (fjern # for å bruke).
# Modell; standard er anthropic: claude-opus-5-5, gemini: gemini-4-hydrogen
#AI_MODEL=claude-sonnet-5-5

# Hvor mye modellen tenker: low | medium | high (standard medium)
#AI_EFFORT=medium

# Fra https://platform.claude.com -> Settings -> API Keys
ANTHROPIC_API_KEY=

# Fra https://aistudio.google.com -> Get API key
GEMINI_API_KEY=

# Hemmelighet for innloggings-tokens. Lokalt finnes en utviklingsverdi; i prod må den settes
# (fly secrets set JWT_SECRET=$(openssl rand -base64 48)).
#JWT_SECRET=

# Port for den innebygde Postgres-basen lokalt (standard 55433, 0 = tilfeldig ledig port)
#FRIDGECAM_LOCAL_DB_PORT=55433
